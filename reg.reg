[HKEY_CLASSES_ROOT\Drive\shell\powershelladmin]
@="Odpri PowerShell (Admin)"
"Icon"="powershell.exe"
"HasLUAShield"=""

[HKEY_CLASSES_ROOT\Drive\shell\powershelladmin\command]
@="powershell.exe -Command \"Start-Process powershell -ArgumentList '-NoExit', '-Command Set-Location -LiteralPath ''%V''' -Verb RunAs\""